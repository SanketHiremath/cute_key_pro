#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/*
 * Key layout:
 *   ┌───┬───┬───┐
 *   │ A │ B │ C │  row 0
 *   ├───┼───┼───┤
 *   │ D │ E │ F │  row 1
 *   ├───┼───┼───┤
 *   │ G │ H │BT │  row 2  (BT = clear profile → enters pairing mode)
 *   └───┴───┴───┘
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp A   &kp B   &kp C
                &kp D   &kp E   &kp F
                &kp G   &kp H   &bt BT_CLR
            >;
        };
    };
};
